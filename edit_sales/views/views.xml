<odoo>
  <data>
    <!-- explicit list view definition -->
 <record model="ir.ui.view" id="edit_sales.list">
      <field name="name">Edit_sale_list</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">



          <xpath expr="//field[@name='partner_id']" position="after">
                <field name="customer_note"/>
                <field name="delivery_priority"/>
               <field name="custom_discount"/>
                <field name="discount_amount"/>
                <field name="minimum_order_amount"/>
          </xpath>
            <xpath expr="//header" position="inside">
                <button name="Ahmed_essam"  string="Evalute_review"  type="object" class="oe_highlight"
                groups="edit_sales.Sales_Order_Approver"/>
          </xpath>

      </field>
    </record>


