<odoo>
    <data>

<!--
    Adding budget level and is Order Requires manager to
    the form view of Purchase Order Form
-->
        <record model="ir.ui.view"
                id="view_purchase_order_form_inherit_puchase_credit_control">
            <field name="name">purchase.order.form.inherit.from.puchase.credit.control</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="budget_level"/>
                    <field name="requires_manager"/>
                </xpath>


            </field>
        </record>


    </data>
</odoo>
