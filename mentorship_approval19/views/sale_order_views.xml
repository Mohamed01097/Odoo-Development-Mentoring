<odoo>
    <record id="view_order_form_mentorship_approval" model="ir.ui.view">
        <field name="name">sale.order.form.mentorship.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_request_approval" type="object" string="Request Approval" class="btn-secondary" invisible="state not in ('draft', 'sent') or amount_total &lt;= 10000 or approval_state in ('waiting', 'approved')"/>
                <button name="action_approve_mentorship" type="object" string="Approve" class="btn-primary" groups="sales_team.group_sale_manager" invisible="state not in ('draft', 'sent') or approval_state != 'waiting'"/>
                <button name="action_reject_mentorship" type="object" string="Reject" groups="sales_team.group_sale_manager" invisible="state not in ('draft', 'sent') or approval_state != 'waiting'"/>
                <field name="approval_state" widget="statusbar" statusbar_visible="not_requested,waiting,approved,rejected"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Mentorship Approval" name="mentorship_sale_approval">
                    <field name="approved_by_id" readonly="1"/>
                    <field name="approved_date" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
