<odoo>

        <record id="user_group" model="res.groups">
            <field name="name">request user</field>
        </record>

        <record id="Manger_group" model="res.groups">
            <field name="name">request Manager</field>
            <field name="implied_ids"
                   eval="[(4,ref('equipment_request.user_group'))]"/>
        </record>

        <record id="user_can_see_his_own_records" model="ir.rule">
            <field name="name">edit user</field>
            <field name="model_id" ref="model_equipment_request"/>
                       <field name="domain_force">[('owner_id', '=', user.id),('company_id', 'in', company_ids)]</field>
            <field name="groups"
                   eval="[(4, ref('equipment_request.user_group'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create"  eval="True"/>
            <field name="perm_unlink"  eval="False"/>

        </record>

    <record id="manager_can_see_all_records" model="ir.rule">
            <field name="name">edit Manager</field>
            <field name="model_id" ref="model_equipment_request"/>
                       <field name="domain_force">[(1, '=', 1),('company_id', 'in', company_ids)]</field>
            <field name="groups"
                   eval="[(4, ref('equipment_request.Manger_group'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write"  eval="True"/>
            <field name="perm_create"  eval="True"/>
            <field name="perm_unlink"  eval="True"/>

        </record>


</odoo>