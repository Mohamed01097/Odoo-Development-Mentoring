<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_inherit_form_from_purchase_approval" model="ir.ui.view">
        <field name="name">purchase.order.inherit.purchase.approval</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="approval_state" readonly="1"/>
            </xpath>


            <xpath expr="//header" position="inside">

                <button name="action_request_approval" type="object"
                        string="Request Approval" class="btn-primary"
                        invisible="approval_state != 'not requested'" />

                <button name="action_approve" type="object"
                        string="Approve Request" class="btn-success"
                        invisible="approval_state != 'waiting approval'"
                        groups="purchase.group_purchase_manager"
                />

                <button name="action_reject" type="object"
                        string="Reject Request" class="btn-danger"
                        invisible="approval_state != 'waiting approval'"
                        groups="purchase.group_purchase_manager"
                />

            </xpath>




        </field>
    </record>
</odoo>
