<odoo>
    <data>
        <record id="view_expense_advance_list" model="ir.ui.view">
            <field name="name">expense.advance.list</field>
            <field name="model">helpdesk.ticket</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="requester_id"/>
                </list>
            </field>
        </record>

        <record id="view_expense_advance_form" model="ir.ui.view">
            <field name="name">expense.advance.form</field>
            <field name="model">helpdesk.ticket</field>
            <field name="arch" type="xml">
                <form string="Expense Advance">

                    <header>
                        <button name="action_submit" type="object" string="Submit" class="btn-primary"
                                invisible="state != 'draft'" groups="expense_advance.group_advance_user"/>

                        <button name="action_approve" type="object" string="Approve" class="btn-primary"
                                groups="helpdesk_ticket.group_advance_manager" invisible="state != 'submitted'"/>

                        <button name="action_open_reject_wizard" type="object" string="Reject"
                                groups="helpdesk_ticket.group_advance_manager" invisible="state != 'submitted'"/>

                        <button name="action_paid" type="object" string="Mark as Paid" class="btn-primary"
                                groups="helpdesk_ticket.group_advance_finance" invisible="state != 'approved'"/>

                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,paid"/>
                    </header>

                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="employee_id" readonly="state != 'draft'"/>
                                <field name="requester_id"/>
                                <field name="manager_id" readonly="1"/>
                            </group>

                            <group>
                                <field name="company_id"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="amount" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <group>
                            <field name="reason" readonly="state != 'draft'"/>
                        </group>
                        <group invisible="state != 'rejected'">
                            <field name="rejection_reason"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_expense_advances" model="ir.actions.act_window">
            <field name="name">Expense Advances</field>
            <field name="res_model">helpdesk.ticket</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_expense_advance_root" name="Expense Advances" sequence="30"/>
        <menuitem id="menu_expense_advance_requests" name="Requests" parent="menu_expense_advance_root"
                  action="action_expense_advances" sequence="10"/>
    </data>
</odoo>
