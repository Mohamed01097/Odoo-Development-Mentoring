<odoo>
    <record id="view_expense_advance_reject_wizard" model="ir.ui.view">
        <field name="name">expense.advance.reject.wizard.form</field>
        <field name="model">expense.advance.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Expense Advance">
                <group><field name="advance_id" invisible="1"/><field name="reason" placeholder="Explain why this request is rejected..."/></group>
                <footer>
                    <button name="action_confirm_reject" type="object" string="Confirm Rejection" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
