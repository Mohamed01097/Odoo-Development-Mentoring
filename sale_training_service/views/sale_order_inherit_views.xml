<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="sale_order_form_training_review" model="ir.ui.view">
            <field name="name">sale.order.form.training.review</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">

                <xpath expr="//sheet/notebook" position="inside">
                    <page string="Training Service">
                        <group>
                            <field name="training_total_quantity" readonly="1"/>
                            <field name="training_customer_phone" readonly="1"/>
                            <field name="training_review_limit"/>
                            <field name="training_needs_review" readonly="1"/>
                        </group>
                    </page>
                </xpath>

                <xpath expr="//header" position="inside">
                    <button
                            name="action_training_evaluate_review"
                            type="object"
                            string="Evaluate Review"
                            class="btn-primary"
                    />
                </xpath>
            </field>
        </record>


    </data>
</odoo>
