<odoo>
  <data>

    <record model="ir.ui.view" id="edit_sale.list">
      <field name="name">Edit_sale list</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">
         <xpath expr="//field[@name='partner_id']" position="after">
                <field name="training_customer_phone"/>
            </xpath>
         <xpath expr="//field[@name='date_order']" position="after">
                <field name="training_review_limit"/>

            </xpath>
           <xpath expr="//field[@name='date_order']" position="after">
                <field name="training_needs_review"/>
          </xpath>
          <xpath expr="//header" position="inside">
                <button name="action_training_evaluate_review"  string="Evalute_review"  type="object" class="oe_highlight"/>
          </xpath>
           <xpath expr="//field[@name='date_order']" position="after">
                <field name="training_total_quantity"  string="total quantity"/>
          </xpath>
      </field>
    </record>



